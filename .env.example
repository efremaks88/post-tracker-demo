# Copy to .env on the target server and fill real values.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Keep true behind HTTPS. Set false only for an explicit local HTTP deployment.
COOKIE_SECURE=true
TRUST_PROXY=loopback
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postprod_tracker
DB_USER=postprod_user
DB_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-string
LDAP_URL=ldap://ldap.example.local:389
LDAP_DOMAIN=example.local
LDAP_BASE_DN=dc=example,dc=local
LDAP_BIND_DN=service-account@example.local
LDAP_BIND_PASSWORD=change-me
SINGLE_SESSION_PER_USER=false
